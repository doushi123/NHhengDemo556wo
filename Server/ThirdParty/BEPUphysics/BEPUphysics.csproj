<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BEPUphysics</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FixMath.NET\FixMath.NET.csproj" />
    <ProjectReference Include="..\BEPUutilities\BEPUutilities.csproj" />
    <!-- 与 Unity 共用物理源码；单独编译，避免上游 AssemblyInfo 混入服务端主程序集。 -->
    <Compile Include="..\..\..\Packages\BEPUphysics\**\*.cs"
             Exclude="..\..\..\Packages\BEPUphysics\bin\**;..\..\..\Packages\BEPUphysics\obj\**"
             Link="Source\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
