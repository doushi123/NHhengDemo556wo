<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BEPUutilities</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FixMath.NET\FixMath.NET.csproj" />
    <!-- 不添加上游 WINDOWS、ALLOWUNSAFE 等宏，与 Unity 默认使用相同代码分支。 -->
    <Compile Include="..\..\..\Packages\BEPUutilities\**\*.cs"
             Exclude="..\..\..\Packages\BEPUutilities\bin\**;..\..\..\Packages\BEPUutilities\obj\**"
             Link="Source\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
