<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 各模块的统一操作结果，两端只维护一份协议定义。 -->
    <Compile Include="..\..\Assets\Scripts\Network\Messages\OperationMessages.cs" Link="Network\Shared\OperationMessages.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 房间数据和 TCP 协议直接复用客户端同一份源码。 -->
    <Compile Include="..\..\Assets\Scripts\Data\RoomData.cs" Link="Room\RoomData.cs" />
    <Compile Include="..\..\Assets\Scripts\Network\Messages\RoomMessages.cs" Link="Room\RoomMessages.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共用协议与配置源码；战斗模拟和地图物理仅在客户端运行。 -->
    <Compile Include="..\..\Assets\Scripts\Const\BattleConst.cs" Link="Battle\Shared\BattleConst.cs" />
    <Compile Include="..\..\Assets\Scripts\Data\BattleConfigData.cs" Link="Battle\Shared\BattleConfigData.cs" />
    <Compile Include="..\..\Assets\Scripts\Configs\BattleConfigSerializer.cs" Link="Battle\Shared\BattleConfigSerializer.cs" />
    <Compile Include="..\..\Assets\Scripts\Data\BattleNetData.cs" Link="Battle\Shared\BattleNetData.cs" />
    <Compile Include="..\..\Assets\Scripts\Test\BattleTestMessages.cs" Link="Test\BattleTestMessages.cs" />
    <Compile Include="..\..\Assets\Scripts\Network\BinaryDataSerializer.cs" Link="Network\Shared\BinaryDataSerializer.cs" />
    <Compile Include="..\..\Assets\Scripts\Network\BattlePacketCodec.cs" Link="Battle\Shared\BattlePacketCodec.cs" />
    <Compile Include="..\..\Packages\com.secretcore.kcp2k\Runtime\**\*.cs" Link="Kcp2k\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\Assets\StreamingAssets\BattleConfig.json')">
    <!-- Unity 编辑器导出的唯一战斗配置文件，构建服务端时复制到输出目录。 -->
    <Content Include="..\..\Assets\StreamingAssets\BattleConfig.json"
             Link="BattleConfig.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\Assets\StreamingAssets\Maps')">
    <!-- 编辑器导出的地图数据与客户端使用同一份文件。 -->
    <Content Include="..\..\Assets\StreamingAssets\Maps\*.json"
             Link="Maps\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
