<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 战斗协议和确定性模拟由 Unity 客户端与独立服务端共用同一份纯 C# 源码。 -->
    <Compile Include="..\..\Assets\Scripts\Data\BattleNetData.cs" Link="Battle\Shared\BattleNetData.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与 Unity 客户端锁定同一版本，保证双端使用相同的定点数实现。 -->
    <PackageReference Include="FixedMathSharp.Lean" Version="7.0.0" />
  </ItemGroup>

</Project>
